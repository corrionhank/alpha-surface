# Template for .env (copy to .env and fill in). This file is committed; .env is not.
# From my.tastytrade.com > Manage > My Profile > API > OAuth Applications (read scope only).
# Paste each value after the = sign, no quotes or spaces needed.

TASTYTRADE_CLIENT_ID=
# Shown once when the app is created.
TASTYTRADE_CLIENT_SECRET=
# From Manage > Create Grant next to the app. Does not expire.
TASTYTRADE_REFRESH_TOKEN=
# true only for the tastytrade sandbox (separate credentials).
TASTYTRADE_SANDBOX=false
