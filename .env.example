# Copy to .env (gitignored) and fill in. Real environment variables override this file.

# tastytrade OAuth app with the read scope only: my.tastytrade.com > Manage > My Profile > API.
# The client secret is shown once at creation; the refresh token comes from Create Grant.
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=
# true only for the tastytrade sandbox, which needs its own credentials.
TASTYTRADE_SANDBOX=false

# Optional. Finnhub adds general market news to the Yahoo headlines (finnhub.io, free tier).
FINNHUB_API_KEY=
# Optional. FRED release dates back the economic calendar if Yahoo's is unavailable.
FRED_API_KEY=

# Optional. Data directory override, used by containers and CI.
# DIP_DATA_DIR=
